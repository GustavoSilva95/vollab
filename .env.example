# Copie para .env e troque a senha. O .env fica fora do git (PRD-NF-09).

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=vollab
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=vollab
POSTGRES_PORT=5432

# --- Engine ---
# Usada ao rodar o engine fora do Docker (uv run python -m vollab.api / alembic).
DATABASE_URL=postgresql+psycopg://vollab:troque-esta-senha@127.0.0.1:5432/vollab
# Testes de integração: banco dedicado, zerado a cada execução do pytest.
TEST_DATABASE_URL=postgresql+psycopg://vollab:troque-esta-senha@127.0.0.1:5432/vollab_test
ENGINE_PORT=8000
LOG_LEVEL=INFO

# --- Web (Next.js) ---
# Para onde o Next encaminha /api/engine/* (rewrites, ADR-09) e onde os Server Components buscam dados.
ENGINE_URL=http://127.0.0.1:8000
